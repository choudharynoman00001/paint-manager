{
  "name": "paint-manager",
  "version": "1.0.0",
  "description": "Paint Manager - offline POS for paint shops (stock, billing, udhaar). Windows desktop app.",
  "main": "electron/main.js",
  "author": "Alpha Blue Digital",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "digital.alphablue.paintmanager",
    "productName": "Paint Manager",
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "app/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Paint Manager",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    }
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  }
}